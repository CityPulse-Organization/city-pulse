# --- User Service ---

# Server & API Configuration
APP_PORT=8084
APP_API_VERSION=v1

# Kafka Configuration
KAFKA_TOPIC_USER_DELETED=user-deleted

# Hibernate & Flyway Configuration
HIBERNATE_DDL_AUTO=validate
FLYWAY_ENABLED=true

# Pagination Configuration
PAGEABLE_DEFAULT_SIZE=20
PAGEABLE_MAX_SIZE=50

# Database Pool Configuration
DB_MIN_IDLE=1
DB_MAX_POOL_SIZE=3
DB_CONNECTION_TIMEOUT=20000
DB_IDLE_TIMEOUT=300000
DB_MAX_LIFETIME=1200000

# Database Configuration
DB_SCHEMA=user_schema
