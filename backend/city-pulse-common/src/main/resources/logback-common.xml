<included>
    <!-- Console: structured output with traceId/spanId correlation -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId:-},%X{spanId:-}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Loki: push logs directly to Loki instance -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>${LOKI_URL:-http://loki:3100}/loki/api/v1/push</url>
        </http>
        <format>
            <label>
                <pattern>service_name=${spring.application.name:-unknown},level=%level,host=${HOSTNAME:-localhost}</pattern>
            </label>
            <message class="com.github.loki4j.logback.JsonLayout">
                <customProvider class="com.github.loki4j.logback.LogbackBackedProvider">
                    <layout class="ch.qos.logback.classic.PatternLayout">
                        <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId:-},%X{spanId:-}] %-5level %logger{36} - %msg%n</pattern>
                    </layout>
                </customProvider>
            </message>
            <sortByTime>true</sortByTime>
        </format>
        <batch>
            <maxItems>100</maxItems>
            <timeoutMs>3000</timeoutMs>
        </batch>
    </appender>

    <!-- Suppress noisy loggers -->
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.springframework.kafka" level="WARN"/>
</included>
